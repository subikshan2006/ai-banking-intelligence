# ====================================================================
# AI BANKING INTELLIGENCE PLATFORM - ENVIRONMENT CONFIGURATION
# ====================================================================

# Backend Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
DATABASE_URL=sqlite:///./banking.db

# LLM Provider Configuration (Optional - Defaults to Deterministic Fallback if not set)
# Supported Providers: openai, claude, local_ollama, deterministic
LLM_PROVIDER=deterministic
LLM_MODEL=gpt-4o
LLM_API_KEY=
LLM_BASE_URL=

# CORS & Frontend Origins
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:3000

# Security & Compliance Secrets
JWT_SECRET_KEY=change-me-to-a-secure-random-key-in-production
APPROVAL_SIGNING_SALT=banking-governance-salt-v1
