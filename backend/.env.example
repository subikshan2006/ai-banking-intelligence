# Banking Intelligence AI Platform Environment Config
ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
DATABASE_URL=sqlite:///./banking_demo.db
FRONTEND_ORIGIN=http://localhost:5173

# Optional LLM Configuration (Leaves blank for Deterministic Fallback Mode)
# Example using Google Gemini OpenAI-compatible endpoint:
LLM_PROVIDER=google
LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=your-google-gemini-api-key-here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Auth / JWT (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY_HOURS=12

# Security & Permissions
DEMO_ROLE=manager
SIMULATION_INTERVAL_SECONDS=4
